# ==== S0-6 D1 sağlama ====
# Cloudflare account (wrangler config'de kayıtlı: paraanaliz@gmail.com)
CF_ACCOUNT_ID=cabd1feddc52ac71b2e9179ec0eb9341
D1_DATABASE_ID=38321f66-c11e-4ea0-82a8-cbcccf0ec4a4
D1_DATABASE_NAME=kapi-db

# Python -> D1 HTTP API (v4 REST) — WRANGLER OAuth çözümü (dashboard token gerekmez)
# Kaynak: ~/.wrangler/config/default.toml (XDG_CONFIG_HOME set ise AppData\Roaming\xdg.config\.wrangler\config\default.toml)
# Access token ~1 saat yaşar; S1 W1 Python client'ı refresh_token ile otomatik yeniler:
#   POST https://dash.cloudflare.com/oauth2/token  (grant_type=refresh_token&client_id=... &refresh_token=...)
CF_OAUTH_CLIENT_ID=54d11594-84e4-41aa-b438-e81b8fa78ee7
D1_API_TOKEN=

# ==== S0-5 GEMINI ====
# investapi/.env içindeki mevcut key kullanılabilir (S3 AI analiz)
GEMINI_API_KEY=

# ==== S1 W1 (FastAPICloud) ====
FASTAPI_SECRET_KEY=change-me
KAP_POLL_INTERVAL_TR=180
KAP_POLL_INTERVAL_OUT=900