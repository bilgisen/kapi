# Python -> D1 HTTP API (v4 REST) — WRANGLER OAuth çözümü (dashboard token gerekmez)
# Kaynak: wrangler default.toml (yerel); SUNUCUDA (FastAPICloud) env olarak ver:
#   D1_ACCESS_TOKEN / D1_REFRESH_TOKEN — wrangler config'teki oauth_token/refresh_token değerleri
#   (servis çalışırken kendi kendini yeniler; yeniden deploy'ta env güncellenmeli)
# Refresh: POST https://dash.cloudflare.com/oauth2/token  (grant_type=refresh_token&client_id=...)
CF_OAUTH_CLIENT_ID=54d11594-84e4-41aa-b438-e81b8fa78ee7
D1_API_TOKEN=

# ==== S0-5 GEMINI ====
# investapi/.env içindeki mevcut key kullanılabilir (S3 AI analiz)
GEMINI_API_KEY=

# ==== S1 W1 (FastAPICloud) ====
