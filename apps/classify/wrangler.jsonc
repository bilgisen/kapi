{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kapi-classify",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-08",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "kapi_db",
      "database_name": "kapi-db",
      "database_id": "05095040-dca3-4509-b534-5b618b1ba9e6"
    }
  ],
  "services": [
    {
      "binding": "KAPI_AI",
      "service": "kapi-ai"
    }
  ],
  "vars": {
    "BATCH_LIMIT": "100"
  }
}