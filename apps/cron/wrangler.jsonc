{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kapi-cron",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-08",
  "compatibility_flags": ["nodejs_compat"],
  "triggers": {
    "crons": ["*/10 * * * *"]
  },
  "vars": {
    "FETCH_URL": "https://kapi-7d527e98.fastapicloud.dev/api/cron/refresh",
    "W3_URL": "https://kapi-ai.jetborsa.workers.dev"
  },
  "services": [
    {
      "binding": "KAPI_AI",
      "service": "kapi-ai"
    }
  ]
}
