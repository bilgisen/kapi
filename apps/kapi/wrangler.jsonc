{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kapi",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-08",
  "compatibility_flags": ["nodejs_compat"],
  "triggers": {
    "crons": ["*/10 * * * *"]
  },
  "d1_databases": [
    {
      "binding": "kapi_db",
      "database_name": "kapi-db",
      "database_id": "05095040-dca3-4509-b534-5b618b1ba9e6"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "kapi_ai_cache",
      "id": "91799353e1ed40b0bb50ce89dda6f56a"
    }
  ],
  "vars": {
    "BATCH_LIMIT": "100",
    "MODEL_LOW": "gemini-2.5-flash",
    "MODEL_HIGH": "gemini-3.1-pro-preview",
    "DAILY_ANALYZE_LIMIT": "1000",
    "KV_TTL_SECONDS": "86400",
    "FETCH_URL": "https://kapi-7d527e98.fastapicloud.dev/api/cron/refresh"
  }
}